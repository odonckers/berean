// Berean on Exact: the test build (docs/frontend-rebuild.md, slice 1).
// Two screens: the Library of installed publications, and one Bible chapter
// with tappable verse numbers, a highlighted verse and a highlighted word.

theme
  page="light-dark(#ffffff, #141414)"
  ink="light-dark(#1d1d1f, #e8e6e1)"
  softInk="light-dark(#6e6e73, #9a9893)"
  verseInk="light-dark(#8a5a00, #e0b35c)"
  card="light-dark(#f2f2f7, #1f1f21)"
  markYellow="light-dark(#fff0a0, #5b4a05)"
  markGreen="light-dark(#cdeec6, #1f4a27)"
  picked="light-dark(#dbe6ff, #233456)"

shape Pub
  key: string
  title: string
  kind: string
  detail: string
  bible: bool

shape Shelf
  message: string
  pubs: Pub[]

shape Run
  id: string
  text: string
  verse: number
  label: bool
  mark: string

shape Para
  id: string
  kind: string
  runs: Run[]

shape Chapter
  title: string
  message: string
  book: number
  chapter: number
  last: number
  paras: Para[]

routes nav
  library "/"
    read "/read/:key"

component Berean
  resource shelf = library() as shape Shelf
  derive here = top(nav)
  derive openKey = (here.name == "read" ? here.params.key : "")
  state book = 43
  state chapterNo = 3
  state tapped = 0
  resource chapter = bibleChapter(openKey, book, chapterNo) as shape Chapter

  action back
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  action tapVerse(v: number)
    tapped = (tapped == v ? 0 : v)
  action previous
    if chapterNo > 1
      chapterNo = chapterNo - 1
      tapped = 0
  action next
    if chapterNo < chapter.last
      chapterNo = chapterNo + 1
      tapped = 0

  view
    main testId="root" navigationKey=`${here.id}` navigationBack="back" navigate=follow width="100%" height="100%" background-color="page"
      for e in stack(nav) key=e.id
        if e.name == "library"
          column navigationKey=`${e.id}` navigationScroll="shelf" position="absolute" inset=0
            header display="flex" align-items="center"
              text "Library" role="heading" aria-level=1 flex=1
            list id="shelf" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 testId="shelf"
              if shelf.message != ""
                section
                  text shelf.message color="softInk" testId="shelf-message"
              section
                for p in shelf.pubs key=p.key
                  link href=path("read", p.key) testId=`pub-${p.key}`
                    column flex=1 min-width=0 gap=2
                      text p.title color="ink"
                      text p.detail font-size="0.8125rem" color="softInk"
                    image "symbol:forward-chevron"
        if e.name == "read"
          column navigationKey=`${e.id}` position="absolute" inset=0
            header display="flex" align-items="center"
              text chapter.title role="heading" aria-level=2 testId="chapter-title"
              button press=previous disabled=(chapterNo <= 1) aria-label="Previous chapter" testId="previous"
                image "symbol:back"
              button press=next disabled=(chapterNo >= chapter.last) aria-label="Next chapter" testId="next"
                image "symbol:forward-chevron"
            if chapter.message != ""
              text chapter.message color="softInk" padding=20 testId="chapter-message"
            list appearance="none" virtualized=true estimated-item-height=120 flex=1 min-height=0 overflow-x="hidden" user-select="text" testId="chapter"
              for p in chapter.paras key=p.id
                view width="100%"
                  if p.kind == "heading"
                    text p.runs.map(r => r.text).join("") role="heading" aria-level=3 font-size="1.0625rem" font-weight=600 color="ink" width="100%" max-width="42rem" margin-left="auto" margin-right="auto" padding-left=20 padding-right=20 padding-top=18 padding-bottom=6 box-sizing="border-box"
                  else
                    text testId=`para-${p.id}` color="ink" font-size="1.0625rem" line-height=1.6 width="100%" max-width="42rem" margin-left="auto" margin-right="auto" padding-left=(p.kind == "poetry" ? 44 : 20) padding-right=20 padding-top=4 padding-bottom=8 box-sizing="border-box"
                      for r in p.runs key=r.id
                        if r.label
                          text `${r.text} ` press=tapVerse(r.verse) font-size="0.75rem" font-weight=700 color="verseInk" background-color=(tapped == r.verse ? "picked" : "transparent") aria-label=`Verse ${r.verse}` testId=`verse-${r.verse}`
                        else
                          text r.text background-color=(tapped == r.verse ? "picked" : r.mark == "" ? "transparent" : r.mark) testId=`run-${r.id}`
