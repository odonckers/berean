{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Lets the pure modules the Node tests load (appearance.ts) import each
    // other by their .ts path, as node --test needs; Metro resolves it too.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "**/*.test.ts",
    "scripts"
  ]
}
