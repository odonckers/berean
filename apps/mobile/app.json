{
  "expo": {
    "name": "Berean",
    "slug": "berean",
    "scheme": "berean",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.odonckers.berean.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "JWPUB Publication",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["com.odonckers.berean.jwpub"]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.odonckers.berean.jwpub",
            "UTTypeDescription": "JWPUB Publication",
            "UTTypeConformsTo": ["public.data", "public.archive"],
            "UTTypeTagSpecification": { "public.filename-extension": ["jwpub"] }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "versionCode": 1000,
      "package": "com.odonckers.berean.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "scheme": "content", "mimeType": "application/octet-stream" },
            { "scheme": "content", "mimeType": "application/jwpub" },
            { "scheme": "content", "mimeType": "application/x-jwpub" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\.jwpub" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\..*\\.jwpub" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\.jwpub" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\..*\\.jwpub" }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Literata",
                "path": "./assets/fonts/literata.ttf",
                "fontDefinitions": [
                  { "weight": 400, "axes": { "opsz": 14, "wght": 400 } },
                  { "weight": 500, "axes": { "opsz": 20, "wght": 500 } },
                  { "weight": 600, "axes": { "opsz": 24, "wght": 600 } },
                  {
                    "path": "./assets/fonts/literata_italic.ttf",
                    "weight": 400,
                    "style": "italic",
                    "axes": { "opsz": 14, "wght": 400 }
                  }
                ]
              }
            ]
          }
        }
      ],
      ["expo-navigation-bar", { "enforceContrast": false }],
      "./plugins/with-android-accent"
    ]
  }
}
