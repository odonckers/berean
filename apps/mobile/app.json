{
  "expo": {
    "name": "Berean",
    "slug": "berean",
    "scheme": "berean",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.odonckers.berean.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.odonckers.berean.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Literata",
                "path": "./assets/fonts/literata.ttf",
                "fontDefinitions": [
                  { "weight": 400, "axes": { "opsz": 14, "wght": 400 } },
                  { "weight": 500, "axes": { "opsz": 20, "wght": 500 } },
                  { "weight": 600, "axes": { "opsz": 24, "wght": 600 } },
                  {
                    "path": "./assets/fonts/literata_italic.ttf",
                    "weight": 400,
                    "style": "italic",
                    "axes": { "opsz": 14, "wght": 400 }
                  }
                ]
              }
            ]
          }
        }
      ],
      ["expo-navigation-bar", { "enforceContrast": false }],
      "./plugins/with-android-accent"
    ]
  }
}
