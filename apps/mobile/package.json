{
  "name": "berean",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test 'src/**/*.test.ts'",
    "gen:theme-tokens": "node scripts/gen-theme-tokens.ts",
    "ubrn:android": "cd modules/berean-ffi-rn && npm run ubrn:android",
    "ubrn:generate": "cd modules/berean-ffi-rn && npm run ubrn:generate",
    "ubrn:ios": "cd modules/berean-ffi-rn && npm run ubrn:ios",
    "ubrn:clean": "cd modules/berean-ffi-rn && npm run ubrn:clean"
  },
  "dependencies": {
    "@expo-google-fonts/material-symbols": "0.4.52",
    "berean-ffi-rn": "file:modules/berean-ffi-rn",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-dev-menu": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~7.0.2"
  }
}
